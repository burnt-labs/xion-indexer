# =============================================================================
# .env.devnet — xion-indexer (DO-248)
# Docker-internal hostnames for local devnet stack
# =============================================================================

# SubQuery node command (use "test" for test mode)
SUB_COMMAND=-f=/app

# Database (docker-internal postgres)
DB_USER=postgres
DB_PASS=postgres
DB_DATABASE=postgres
DB_HOST=postgres
DB_PORT=5432

# Chain endpoint (docker-internal)
# Configure in project.ts or as SubQuery startup arg
# ENDPOINT=http://haproxy:26657
